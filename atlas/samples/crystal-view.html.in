<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
  <title>Покрути кристалл · gitEdit</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; padding: 1rem; background: #f6f0df; color: #183934; font: 1rem/1.5 system-ui, sans-serif; }
    main { max-width: 38rem; margin: 1rem auto; }
    h1 { margin: .2em 0; font-size: clamp(1.6rem, 6vw, 2.3rem); }
    small { color: #496059; letter-spacing: .1em; }
    svg { display: block; width: 100%; background: #152c2b; border-radius: .5rem; touch-action: none; cursor: grab; }
    svg:active { cursor: grabbing; }
    fieldset { margin: 1rem 0 0; padding: .6rem 1rem 1rem; border: 1px solid #85988b; }
    label.track { display: grid; grid-template-columns: 6rem 1fr; gap: .5rem; align-items: center; margin: .4em 0; }
    input[type=range] { width: 100%; margin: 0; accent-color: #237065; }
    button { margin: .5rem 0 0 1rem; padding: .3em .6em; font: inherit; }
    :focus-visible { outline: 3px solid #ae4c20; outline-offset: 3px; }
  </style>
</head>
<body><main>
  <small>НОЧНАЯ СМЕНА / 01</small>
  <h1>Покрути кристалл</h1>
  <p>Потяни мышью или пальцем за модель. С клавиатуры меняй ракурс и масштаб стрелками на ползунках.</p>
  <svg id="view" viewBox="-240 -140 480 280" role="img" aria-labelledby="title">
    <title id="title">Кристалл из восьми треугольных граней</title><g id="faces"></g>
  </svg>
  <fieldset><legend>Положение модели</legend>
    <label class="track">Поворот <input id="yaw" type="range" min="-180" max="180" value="16"></label>
    <label class="track">Наклон <input id="pitch" type="range" min="-90" max="90" value="12"></label>
    <label class="track">Масштаб <input id="zoom" type="range" min="60" max="160" value="100"></label>
    <label><input id="wire" type="checkbox"> Каркас</label><button id="reset" type="button">Исходный вид</button>
  </fieldset>
  <noscript><p>Для вращения в этом файле нужен JavaScript. Четыре неподвижных ракурса есть в README.</p></noscript>
</main>
<pre id="stl" hidden>@@ASCII_STL@@</pre>
<script>
  // The export embeds the actual facets; opening the HTML never fetches a model or library.
  const el = id => document.getElementById(id);
  const [view, layer, yaw, pitch, zoom, wire] = ['view','faces','yaw','pitch','zoom','wire'].map(el);
  const triangles = [];
  for (const row of el('stl').textContent.trim().split('\n')) {
    const [kind, ...values] = row.trim().split(/\s+/);
    if (kind === 'facet') triangles.push({normal: values.slice(1).map(Number), points: []});
    if (kind === 'vertex') triangles[triangles.length - 1].points.push(values.map(Number));
  }
  const dot = (n, x, y, z) => n[0]*x + n[1]*y + n[2]*z;
  function draw() {
    const a = yaw.valueAsNumber*Math.PI/180, t = pitch.valueAsNumber*Math.PI/180;
    const ca = Math.cos(a), sa = Math.sin(a), ct = Math.cos(t), st = Math.sin(t), scale = zoom.valueAsNumber*.064;
    const project = ([x,y,z]) => [scale*(x*ca+y*sa), scale*((x*sa-y*ca)*st-(z-17)*ct)];
    const back = [], front = [];
    for (const {normal, points} of triangles) {
      const visible = dot(normal, sa*ct, -ca*ct, st) > 0;
      if (!visible && !wire.checked) continue;
      const poly = document.createElementNS(view.namespaceURI, 'polygon');
      poly.setAttribute('points', points.map(p => project(p).join(',')).join(' '));
      const k = Math.max(0, dot(normal, .56, -.35, .75));
      const rgb = normal[0] > .4 ? [66+183*k,85+106*k,82+55*k] : [42+130*k,81+153*k,82+115*k];
      poly.setAttribute('fill', wire.checked ? 'none' : `rgb(${rgb.map(Math.round).join(',')})`);
      poly.setAttribute('stroke', visible ? '#a0c7b3' : '#647e74');
      if (!visible) poly.setAttribute('stroke-dasharray', '3 3');
      (visible ? front : back).push(poly);
    }
    layer.replaceChildren(...back, ...front);
  }
  let drag = null;
  view.onpointerdown = e => {
    if (!e.isPrimary || e.button !== 0) return;
    drag = {id:e.pointerId, x:e.clientX, y:e.clientY, a:yaw.valueAsNumber, t:pitch.valueAsNumber};
    view.setPointerCapture(e.pointerId);
  };
  view.onpointermove = e => {
    if (!drag || e.pointerId !== drag.id) return;
    const degrees = drag.a - (e.clientX - drag.x)*.7;
    yaw.value = ((degrees + 180) % 360 + 360) % 360 - 180;
    pitch.value = drag.t + (e.clientY - drag.y)*.6;
    draw();
  };
  view.onlostpointercapture = () => { drag = null; };
  document.querySelector('fieldset').oninput = draw;
  el('reset').onclick = () => {
    for (const slider of [yaw,pitch,zoom]) slider.value = slider.defaultValue;
    wire.checked = false;
    draw();
  };
  draw(); // No timer or animation loop: redraw only on input.
</script>
</body></html>
