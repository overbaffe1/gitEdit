<svg xmlns="http://www.w3.org/2000/svg" width="224" height="272" viewBox="0 0 224 272" role="img" aria-labelledby="title desc" xml:lang="ru">
  <title id="title">$day_name / $night_name · проба $number</title>
  <desc id="desc">$mark_name. Сверху светлая бумага, снизу тёмная. Контраст текста на бумаге: $day_ratio:1 и $night_ratio:1.</desc>
  <defs>
    <!-- One engraved plate, pulled in two inks across the join. -->
    <path id="stock" d="M15 3H209L220 14V129a7 7 0 0 0 0 14v115l-11 11H15L4 258V143a7 7 0 0 0 0-14V14Z"/>
    <clipPath id="die"><use href="#stock"/></clipPath>
    <clipPath id="light"><rect width="224" height="136"/></clipPath>
    <clipPath id="dark"><rect y="136" width="224" height="136"/></clipPath>
    <g id="plate">
      $engraving
    </g>
    <g id="rules" fill="none" stroke="currentColor">
      <path d="M18 36H206M18 236H206" stroke-width=".8"/>
      <path d="M18 136h15m-9-4v8m167-4h15m-6-4v8" stroke-width="1.2"/>
    </g>
  </defs>
  <g clip-path="url(#die)">
    <g clip-path="url(#light)" color="$day_ink" fill="$day_accent">
      <rect width="224" height="136" fill="$day_paper"/>
      <use href="#plate"/><use href="#rules"/>
    </g>
    <g clip-path="url(#dark)" color="$night_ink" fill="$night_accent">
      <rect y="136" width="224" height="136" fill="$night_paper"/>
      <use href="#plate"/><use href="#rules"/>
    </g>
    <g font-family="ui-monospace, monospace" font-size="12">
      <g fill="$day_ink"><text x="18" y="26">$number.А / СВЕТ</text><text x="206" y="26" text-anchor="end">$day_ratio:1</text></g>
      <g fill="$night_ink"><text x="18" y="256">$number.Б / ТЕНЬ</text><text x="206" y="256" text-anchor="end">$night_ratio:1</text></g>
    </g>
    <g font-family="Georgia, 'DejaVu Serif', serif" font-size="25">
      <text x="17" y="66" fill="$day_ink">$day_name</text>
      <text x="17" y="226" fill="$night_ink">$night_name</text>
    </g>
  </g>
  <use href="#stock" fill="none" stroke="$day_ink" stroke-width="1.2"/>
</svg>
